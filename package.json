{
  "name": "crucible-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.22 <23",
    "npm": ">=10.9 <11"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:production": "npm run build && node scripts/check-production-runtime.mjs && playwright test --config=playwright.production.config.ts",
    "test:visual": "playwright test tests/browser/design-system.spec.ts tests/browser/route-scenarios.spec.ts tests/browser/project-inspector.spec.ts",
    "test:visual:update": "playwright test tests/browser/design-system.spec.ts tests/browser/route-scenarios.spec.ts tests/browser/project-inspector.spec.ts --update-snapshots",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript contracts/crucible-api.json -o src/generated/crucible-api.ts",
    "api:check": "node scripts/check-openapi.mjs",
    "boundary:check": "node scripts/check-server-boundary.mjs",
    "design:check": "node scripts/check-design-tokens.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "skills:list": "node node_modules/@tanstack/intent/dist/cli.mjs list --no-notices",
    "skills:load": "node node_modules/@tanstack/intent/dist/cli.mjs load",
    "skills:stale": "node node_modules/@tanstack/intent/dist/cli.mjs stale",
    "audit": "npm audit --audit-level=high",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run api:check && npm run boundary:check && npm run design:check && npm run docs:check && npm run secrets:check && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource/noto-sans": "^5.2.9",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/router-plugin": "1.168.35",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cytoscape": "3.34.3",
    "cytoscape-elk": "2.3.0",
    "lucide-react": "1.39.0",
    "openapi-fetch": "0.17.0",
    "qr-scanner": "1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.20.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/intent": "0.3.8",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "jsdom": "28.1.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260902-190952-ee541098",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
