{
  "name": "crucible-hub",
  "version": "0.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.13 <27",
    "npm": ">=11.20 <12"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:fixtures": "node scripts/dev-scenario.mjs fixtures",
    "dev:api-local": "node scripts/dev-scenario.mjs api-local",
    "dev:api-staging": "node scripts/dev-scenario.mjs api-staging",
    "dev:api-main": "node scripts/dev-scenario.mjs api-main",
    "dev:orcid-local": "node scripts/dev-scenario.mjs orcid-local",
    "dev:orcid-staging": "node scripts/dev-scenario.mjs orcid-staging",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test tests/browser/account-profile.spec.ts tests/browser/batch-removal.spec.ts tests/browser/dataset-uploads.spec.ts tests/browser/deletion-geometry.spec.ts tests/browser/design-system.spec.ts tests/browser/file-downloads.spec.ts tests/browser/resource-deletion-request.spec.ts tests/browser/route-scenarios.spec.ts tests/browser/shell.spec.ts tests/browser/staged-add.spec.ts --workers=1",
    "test:production": "npm run build && node scripts/check-production-runtime.mjs && playwright test --config=playwright.production.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "unused:check": "knip --no-progress",
    "typecheck": "tsc --noEmit",
    "api:fetch": "node scripts/fetch-openapi.mjs",
    "api:generate": "openapi-typescript contracts/crucible-api.json -o src/generated/crucible-api.ts",
    "api:check": "node scripts/check-openapi.mjs",
    "boundary:check": "node scripts/check-server-boundary.mjs",
    "design:check": "node scripts/check-design-tokens.mjs && node scripts/check-color-contrast.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "skills:list": "node node_modules/@tanstack/intent/dist/cli.mjs list --no-notices",
    "skills:load": "node node_modules/@tanstack/intent/dist/cli.mjs load",
    "skills:stale": "node node_modules/@tanstack/intent/dist/cli.mjs stale",
    "audit": "npm audit --omit=dev --audit-level=high",
    "release": "node scripts/release.mjs",
    "validate:static": "npm run format:check && npm run lint && npm run typecheck && npm run unused:check && npm test && npm run api:check && npm run boundary:check && npm run design:check && npm run docs:check && npm run secrets:check",
    "validate": "npm run validate:static && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-mono": "^5.3.0",
    "@google-cloud/cloud-sql-connector": "1.13.0",
    "@lezer/highlight": "1.2.5",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/router-plugin": "1.169.0",
    "@xyflow/react": "13.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "elkjs": "0.12.1",
    "hash-wasm": "4.13.0",
    "lucide-react": "1.73.0",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.1",
    "qr-scanner": "1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tanstack/eslint-config": "0.5.0",
    "@tanstack/intent": "0.5.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "culori": "^4.0.2",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "knip": "6.45.1",
    "nitro": "npm:nitro-nightly@3.0.1-20260902-190952-ee541098",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core"
    ]
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch@^10": "^11.0.1",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
