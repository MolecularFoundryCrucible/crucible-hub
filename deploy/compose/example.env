# Copy to .env and adjust. Secrets live in ./secrets, never here.

# Same machine as the API bundle:
COMPOSE_FILE=compose.yaml:compose.api-network.yaml
CRUCIBLE_NETWORK=crucible
CRUCIBLE_API_BASE_URL=http://api:8000
HUB_API_ALLOW_HTTP=true

# Separate machine (comment out the block above):
# COMPOSE_FILE=compose.yaml:compose.published.yaml
# HUB_BIND_ADDRESS=10.0.0.5
# CRUCIBLE_API_BASE_URL=https://crucible.example.org/api/v3

# The address people use, without a trailing slash.
HUB_PUBLIC_ORIGIN=https://crucible.example.org
# The API address browsers use for sign-in.
HUB_AUTH_PUBLIC_API_URL=https://crucible.example.org/api/v3
# Proxies in front of the Hub that append to X-Forwarded-For.
HUB_TRUSTED_PROXY_HOPS=1
